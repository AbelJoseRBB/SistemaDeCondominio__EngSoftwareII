<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<!--
    FORMULARIO DE CADASTRO / EDICAO DE RESERVA
    Carregado como conteudo de um Dialog pelo ReservaListController.
    Controller: com.condomanager.controller.reserva.ReservaFormController
-->
<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.condomanager.controller.reserva.ReservaFormController"
      spacing="16"
      prefWidth="520"
      styleClass="modal-container"
      stylesheets="@../../css/style.css">

    <!-- Titulo do Formulario -->
    <Label text="Dados da Reserva" styleClass="modal-title"/>

    <!-- Formulario em Grade -->
    <GridPane hgap="16" vgap="14">
        <columnConstraints>
            <ColumnConstraints percentWidth="50"/>
            <ColumnConstraints percentWidth="50"/>
        </columnConstraints>

        <!-- LINHA 0: Unidade (largura total) -->
        <VBox spacing="5" GridPane.columnSpan="2" GridPane.rowIndex="0">
            <Label text="Unidade *" styleClass="field-label"/>
            <ComboBox fx:id="cmbUnidade"
                      maxWidth="Infinity"
                      promptText="Selecione a unidade..."
                      styleClass="combo-box"/>
        </VBox>

        <!-- LINHA 1: Area Comum (largura total) -->
        <VBox spacing="5" GridPane.columnSpan="2" GridPane.rowIndex="1">
            <Label text="Área Comum *" styleClass="field-label"/>
            <ComboBox fx:id="cmbAreaComum"
                      maxWidth="Infinity"
                      promptText="Selecione a área comum..."
                      styleClass="combo-box"/>
        </VBox>

        <!-- LINHA 2: Data + Horarios -->
        <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="2">
            <Label text="Data *" styleClass="field-label"/>
            <DatePicker fx:id="dpData"
                        maxWidth="Infinity"
                        promptText="dd/mm/aaaa"
                        styleClass="date-picker"/>
        </VBox>

        <!-- Horarios Lado a Lado -->
        <HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="2">
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="Início *" styleClass="field-label"/>
                <TextField fx:id="txtHoraInicio"
                           promptText="08:00"
                           styleClass="text-field"/>
            </VBox>
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="Fim *" styleClass="field-label"/>
                <TextField fx:id="txtHoraFim"
                           promptText="12:00"
                           styleClass="text-field"/>
            </VBox>
        </HBox>

        <!-- LINHA 3: Dica de Formato -->
        <Label text="Formato dos horários: HH:mm (ex: 08:00, 14:30, 20:00)"
               style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;"
               GridPane.columnSpan="2"
               GridPane.rowIndex="3"/>

        <!-- LINHA 4: Observacoes (largura total) -->
        <VBox spacing="5" GridPane.columnSpan="2" GridPane.rowIndex="4">
            <Label text="Observações (opcional)" styleClass="field-label"/>
            <TextArea fx:id="txtObservacoes"
                      promptText="Informações adicionais sobre a reserva..."
                      prefRowCount="3"
                      wrapText="true"
                      maxWidth="Infinity"
                      styleClass="text-field"/>
        </VBox>

    </GridPane>

    <!-- Botoes de Acao -->
    <HBox alignment="CENTER_RIGHT" spacing="12"
          style="-fx-padding: 14 0 0 0; -fx-border-color: #e2e8f0; -fx-border-width: 1 0 0 0;">

        <Button fx:id="btnCancelar"
                text="Cancelar"
                onAction="#onCancelar"
                styleClass="btn-secondary"/>

        <Button fx:id="btnSalvar"
                text="Salvar"
                onAction="#onSalvar"
                defaultButton="true"
                styleClass="btn-primary"/>
    </HBox>

</VBox>
