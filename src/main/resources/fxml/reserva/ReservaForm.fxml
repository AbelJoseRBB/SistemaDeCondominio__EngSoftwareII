<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<!--
    FORMULARIO DE CADASTRO / EDICAO DE RESERVA
    Carregado como conteudo de um Dialog pelo ReservaListController.
    Controller: com.condomanager.controller.reserva.ReservaFormController
-->
<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.condomanager.controller.reserva.ReservaFormController"
      spacing="16"
      prefWidth="500"
      style="-fx-padding: 24 28 8 28; -fx-background-color: white;">

    <!-- ============================================================ -->
    <!-- LINHA 1: Unidade (largura total)                              -->
    <!-- ============================================================ -->
    <VBox spacing="6">
        <Label text="Unidade *"
               style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #334155;"/>
        <ComboBox fx:id="cmbUnidade"
                  maxWidth="Infinity"
                  promptText="Selecione a unidade..."
                  style="-fx-background-color: white;
                         -fx-border-color: #d1d5db;
                         -fx-border-radius: 5;
                         -fx-background-radius: 5;
                         -fx-font-size: 13px;"/>
    </VBox>

    <!-- ============================================================ -->
    <!-- LINHA 2: Area Comum (largura total)                           -->
    <!-- ============================================================ -->
    <VBox spacing="6">
        <Label text="Área Comum *"
               style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #334155;"/>
        <ComboBox fx:id="cmbAreaComum"
                  maxWidth="Infinity"
                  promptText="Selecione a area..."
                  style="-fx-background-color: white;
                         -fx-border-color: #d1d5db;
                         -fx-border-radius: 5;
                         -fx-background-radius: 5;
                         -fx-font-size: 13px;"/>
    </VBox>

    <!-- ============================================================ -->
    <!-- LINHA 3: Data + Hora Inicio + Hora Fim                        -->
    <!-- ============================================================ -->
    <HBox spacing="16">

        <!-- Data da reserva -->
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Data *"
                   style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #334155;"/>
            <DatePicker fx:id="dpData"
                        maxWidth="Infinity"
                        promptText="dd/mm/aaaa"
                        style="-fx-background-color: white;
                               -fx-border-color: #d1d5db;
                               -fx-border-radius: 5;
                               -fx-background-radius: 5;
                               -fx-font-size: 13px;"/>
        </VBox>

        <!-- Hora de inicio -->
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Hora Início *"
                   style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #334155;"/>
            <TextField fx:id="txtHoraInicio"
                       promptText="08:00"
                       maxWidth="Infinity"
                       style="-fx-background-color: white;
                              -fx-border-color: #d1d5db;
                              -fx-border-radius: 5;
                              -fx-background-radius: 5;
                              -fx-padding: 8 12 8 12;
                              -fx-font-size: 13px;
                              -fx-text-fill: #334155;
                              -fx-prompt-text-fill: #9ca3af;"/>
        </VBox>

        <!-- Hora de fim -->
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Hora Fim *"
                   style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #334155;"/>
            <TextField fx:id="txtHoraFim"
                       promptText="12:00"
                       maxWidth="Infinity"
                       style="-fx-background-color: white;
                              -fx-border-color: #d1d5db;
                              -fx-border-radius: 5;
                              -fx-background-radius: 5;
                              -fx-padding: 8 12 8 12;
                              -fx-font-size: 13px;
                              -fx-text-fill: #334155;
                              -fx-prompt-text-fill: #9ca3af;"/>
        </VBox>

    </HBox>

    <Label text="Formato dos horarios: HH:MM  (ex: 08:00, 14:30, 20:00)"
           style="-fx-font-size: 11px; -fx-text-fill: #9ca3af;"/>

    <!-- ============================================================ -->
    <!-- LINHA 4: Observacoes (opcional)                               -->
    <!-- ============================================================ -->
    <VBox spacing="6">
        <Label text="Observações (opcional)"
               style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #334155;"/>
        <TextArea fx:id="txtObservacoes"
                  promptText="Informacoes adicionais sobre a reserva..."
                  prefRowCount="3"
                  wrapText="true"
                  maxWidth="Infinity"
                  style="-fx-background-color: white;
                         -fx-border-color: #d1d5db;
                         -fx-border-radius: 5;
                         -fx-background-radius: 5;
                         -fx-padding: 8 12 8 12;
                         -fx-font-size: 13px;
                         -fx-text-fill: #334155;
                         -fx-prompt-text-fill: #9ca3af;"/>
    </VBox>

    <!-- ============================================================ -->
    <!-- SEPARADOR + BOTOES                                            -->
    <!-- ============================================================ -->
    <Separator style="-fx-padding: 4 0 0 0;"/>

    <HBox alignment="CENTER_RIGHT" spacing="12"
          style="-fx-padding: 0 0 4 0;">

        <Button fx:id="btnCancelar"
                text="Cancelar"
                onAction="#onCancelar"
                style="-fx-background-color: white;
                       -fx-text-fill: #374151;
                       -fx-font-size: 13px;
                       -fx-border-color: #d1d5db;
                       -fx-border-radius: 5;
                       -fx-background-radius: 5;
                       -fx-padding: 8 20 8 20;
                       -fx-cursor: hand;"/>

        <Button fx:id="btnSalvar"
                text="Salvar"
                onAction="#onSalvar"
                defaultButton="true"
                style="-fx-background-color: #203a5c;
                       -fx-text-fill: white;
                       -fx-font-size: 13px;
                       -fx-font-weight: bold;
                       -fx-border-radius: 5;
                       -fx-background-radius: 5;
                       -fx-padding: 8 20 8 20;
                       -fx-cursor: hand;"/>
    </HBox>

</VBox>

