<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<!--
    DASHBOARD - Painel Geral com Resumo das Operacoes e Atividades Recentes
    Controller: com.condomanager.controller.DashboardController
-->
<VBox xmlns:fx="http://javafx.com/fxml/1"
      xmlns="http://javafx.com/javafx/21"
      fx:controller="com.condomanager.controller.DashboardController"
      spacing="20"
      style="-fx-background-color: #f1f5f9; -fx-padding: 24 30 24 30;"
      stylesheets="@../css/style.css">

    <!-- ================================================================ -->
    <!-- CABECALHO DO DASHBOARD                                            -->
    <!-- ================================================================ -->
    <HBox alignment="CENTER_LEFT" spacing="16">
        <VBox spacing="3" HBox.hgrow="ALWAYS">
            <Label text="Dashboard"
                   style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
            <Label fx:id="lblSaudacao"
                   text="Visão geral da administração e resumo das operações do condomínio"
                   style="-fx-font-size: 13px; -fx-text-fill: #64748b;"/>
        </VBox>

        <!-- Botao de recarregar dados do painel -->
        <Button fx:id="btnAtualizar"
                text="↻  Atualizar Dados"
                onAction="#onAtualizar"
                styleClass="dashboard-refresh-btn"/>
    </HBox>

    <!-- ================================================================ -->
    <!-- CARDS DE RESUMO OPERACIONAL (KPIs)                               -->
    <!-- ================================================================ -->
    <HBox spacing="16">

        <!-- Card: Unidades -->
        <VBox fx:id="cardUnidades"
              styleClass="summary-card"
              HBox.hgrow="ALWAYS" prefWidth="220" spacing="4"
              onMouseClicked="#navegarUnidades">
            <Label text="TOTAL DE UNIDADES" styleClass="card-label"/>
            <Label fx:id="lblTotalUnidades" text="0" styleClass="card-value"/>
            <Label text="Imóveis registrados" styleClass="card-subtext"/>
        </VBox>

        <!-- Card: Moradores -->
        <VBox fx:id="cardMoradores"
              styleClass="summary-card"
              HBox.hgrow="ALWAYS" prefWidth="220" spacing="4"
              onMouseClicked="#navegarMoradores">
            <Label text="MORADORES" styleClass="card-label"/>
            <Label fx:id="lblTotalMoradores" text="0" styleClass="card-value"/>
            <Label text="Moradores vinculados" styleClass="card-subtext"/>
        </VBox>

        <!-- Card: Taxas Pendentes -->
        <VBox fx:id="cardTaxas"
              styleClass="summary-card"
              HBox.hgrow="ALWAYS" prefWidth="220" spacing="4"
              onMouseClicked="#navegarTaxas">
            <Label text="TAXAS PENDENTES" styleClass="card-label"/>
            <Label fx:id="lblTaxasPendentes" text="0" styleClass="card-value"/>
            <Label text="Aguardando quitação" styleClass="card-subtext"/>
        </VBox>

        <!-- Card: Manutencoes em Aberto -->
        <VBox fx:id="cardManutencoes"
              styleClass="summary-card"
              HBox.hgrow="ALWAYS" prefWidth="220" spacing="4"
              onMouseClicked="#navegarManutencoes">
            <Label text="MANUTENÇÕES EM ABERTO" styleClass="card-label"/>
            <Label fx:id="lblManutencoesAbertas" text="0" styleClass="card-value"/>
            <Label text="Solicitadas / em andamento" styleClass="card-subtext"/>
        </VBox>

    </HBox>

    <!-- ================================================================ -->
    <!-- TABELAS DE ATIVIDADES RECENTES                                    -->
    <!-- ================================================================ -->
    <HBox spacing="16" VBox.vgrow="ALWAYS">

        <!-- Tabela: Reservas Recentes de Areas Comuns -->
        <VBox spacing="10" HBox.hgrow="ALWAYS" styleClass="dashboard-table-card">
            <HBox alignment="CENTER_LEFT">
                <Label text="📅  Reservas Recentes de Áreas Comuns"
                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                <Pane HBox.hgrow="ALWAYS"/>
                <Button text="Ver todas →"
                        onAction="#navegarReservas"
                        style="-fx-background-color: transparent; -fx-text-fill: #2563eb; -fx-cursor: hand; -fx-font-size: 12px;"/>
            </HBox>

            <TableView fx:id="tblReservasRecentes" VBox.vgrow="ALWAYS" prefHeight="320">
                <placeholder>
                    <Label text="Nenhuma reserva recente registrada."
                           style="-fx-text-fill: #9ca3af; -fx-font-size: 13px;"/>
                </placeholder>
                <columns>
                    <TableColumn fx:id="colReservaArea"     text="ÁREA COMUM" prefWidth="130"/>
                    <TableColumn fx:id="colReservaUnidade"  text="UNIDADE"    prefWidth="90"/>
                    <TableColumn fx:id="colReservaData"     text="DATA"       prefWidth="90" style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="colReservaHorario"  text="HORÁRIO"    prefWidth="110" style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="colReservaSituacao" text="SITUAÇÃO"   prefWidth="110" style="-fx-alignment: CENTER;"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>

        <!-- Tabela: Ocorrencias Recentes -->
        <VBox spacing="10" HBox.hgrow="ALWAYS" styleClass="dashboard-table-card">
            <HBox alignment="CENTER_LEFT">
                <Label text="⚠️  Ocorrências Recentes"
                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                <Pane HBox.hgrow="ALWAYS"/>
                <Button text="Ver todas →"
                        onAction="#navegarOcorrencias"
                        style="-fx-background-color: transparent; -fx-text-fill: #2563eb; -fx-cursor: hand; -fx-font-size: 12px;"/>
            </HBox>

            <TableView fx:id="tblOcorrenciasRecentes" VBox.vgrow="ALWAYS" prefHeight="320">
                <placeholder>
                    <Label text="Nenhuma ocorrência recente registrada."
                           style="-fx-text-fill: #9ca3af; -fx-font-size: 13px;"/>
                </placeholder>
                <columns>
                    <TableColumn fx:id="colOcorrDescricao" text="TÍTULO / DESCRIÇÃO" prefWidth="150"/>
                    <TableColumn fx:id="colOcorrLocal"     text="LOCAL / UNIDADE"   prefWidth="100"/>
                    <TableColumn fx:id="colOcorrData"      text="DATA"              prefWidth="100" style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="colOcorrSituacao"  text="SITUAÇÃO"          prefWidth="110" style="-fx-alignment: CENTER;"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>

    </HBox>

</VBox>