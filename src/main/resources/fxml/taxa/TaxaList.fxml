<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      xmlns="http://javafx.com/javafx/21"
      fx:controller="com.condomanager.controller.taxa.TaxaListController"
      spacing="20"
      styleClass="container"
      stylesheets="@../../css/style.css">

    <!-- CABECALHO E BOTOES DE ACAO -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Taxas Condominiais" styleClass="heading"/>
            <Label text="Controle de cobranças e pagamentos" styleClass="subheading"/>
        </VBox>

        <TextField fx:id="txtBusca" promptText="🔍 Buscar por unidade ou referência..."
                   prefWidth="260" styleClass="search-field"/>
        
        <ComboBox fx:id="cbFiltroSituacao" prefWidth="130" styleClass="combo-box"/>

        <Button text="+ Nova Taxa" onAction="#onNovaTaxa"
                styleClass="btn-primary"/>
    </HBox>

    <!-- CARDS DE RESUMO -->
    <HBox spacing="16">
        <!-- Total -->
        <HBox alignment="CENTER" spacing="8" styleClass="summary-card" prefWidth="150" prefHeight="50" style="-fx-padding: 10;">
            <Label fx:id="lblTotal" text="0" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #64748b;"/>
            <Label text="Total" style="-fx-font-size: 13px; -fx-text-fill: #64748b; -fx-font-weight: bold;"/>
        </HBox>
        
        <!-- Pagas -->
        <HBox alignment="CENTER" spacing="8" styleClass="summary-card" prefWidth="150" prefHeight="50" style="-fx-padding: 10; -fx-border-color: #dcfce7;">
            <Label fx:id="lblPagas" text="0" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #15803d;"/>
            <Label text="Pagas" style="-fx-font-size: 13px; -fx-text-fill: #15803d; -fx-font-weight: bold;"/>
        </HBox>

        <!-- Pendentes -->
        <HBox alignment="CENTER" spacing="8" styleClass="summary-card" prefWidth="150" prefHeight="50" style="-fx-padding: 10; -fx-border-color: #fef9c3;">
            <Label fx:id="lblPendentes" text="0" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #854d0e;"/>
            <Label text="Pendentes" style="-fx-font-size: 13px; -fx-text-fill: #854d0e; -fx-font-weight: bold;"/>
        </HBox>

        <!-- Atrasadas -->
        <HBox alignment="CENTER" spacing="8" styleClass="summary-card" prefWidth="150" prefHeight="50" style="-fx-padding: 10; -fx-border-color: #fee2e2;">
            <Label fx:id="lblAtrasadas" text="0" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #b91c1c;"/>
            <Label text="Atrasadas" style="-fx-font-size: 13px; -fx-text-fill: #b91c1c; -fx-font-weight: bold;"/>
        </HBox>
    </HBox>

    <!-- TABELA -->
    <VBox VBox.vgrow="ALWAYS" styleClass="dashboard-table-card">
        <TableView fx:id="tabelaTaxas" VBox.vgrow="ALWAYS" styleClass="table-view-ocorrencias">
            <placeholder>
                <Label text="Nenhuma taxa encontrada." style="-fx-text-fill: #9ca3af; -fx-font-size: 14px;"/>
            </placeholder>
            <columns>
                <TableColumn fx:id="colUnidade" text="UNIDADE" prefWidth="120"/>
                <TableColumn fx:id="colReferencia" text="REFERÊNCIA" prefWidth="150"/>
                <TableColumn fx:id="colVencimento" text="VENCIMENTO" prefWidth="150"/>
                <TableColumn fx:id="colValor" text="VALOR" prefWidth="150"/>
                <TableColumn fx:id="colSituacao" text="SITUAÇÃO" prefWidth="150" style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="colAcoes" text="AÇÕES" prefWidth="120" style="-fx-alignment: CENTER;"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
        <HBox alignment="CENTER_LEFT" style="-fx-padding: 10 0 0 0;">
            <Label fx:id="lblStatusTabela" text="0 registro(s)" style="-fx-text-fill: #9ca3af; -fx-font-size: 12px;"/>
        </HBox>
    </VBox>
</VBox>