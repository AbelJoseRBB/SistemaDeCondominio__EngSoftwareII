<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      xmlns="http://javafx.com/javafx/21"
      fx:controller="com.condomanager.controller.taxa.TaxaListController"
      spacing="16"
      style="-fx-background-color: #f5f7fa; -fx-padding: 24 28 24 28;"
      stylesheets="@../../css/style.css">

    <VBox spacing="2">
        <Label text="Taxas Condominiais" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1a2332;"/>
        <Label text="Gestão e controle financeiro de boletos e taxas condominiais" style="-fx-font-size: 13px; -fx-text-fill: #7a8b9a;"/>
    </VBox>

    <VBox alignment="CENTER" spacing="12" VBox.vgrow="ALWAYS"
          style="-fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 40;">
        <Label text="💰" style="-fx-font-size: 40px;"/>
        <Label text="Módulo de Taxas Condominiais" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
        <Label text="Este módulo está em fase de estruturação pelo time de desenvolvimento." style="-fx-text-fill: #64748b; -fx-font-size: 13px;"/>
    </VBox>
</VBox>