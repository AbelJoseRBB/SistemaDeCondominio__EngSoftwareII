<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<!--
    FORMULARIO DE CADASTRO / EDICAO DE TAXA CONDOMINIAL
    Controller: com.condomanager.controller.taxa.TaxaFormController
-->
<VBox xmlns:fx="http://javafx.com/fxml/1"
      xmlns="http://javafx.com/javafx/21"
      fx:controller="com.condomanager.controller.taxa.TaxaFormController"
      spacing="16"
      prefWidth="500"
      styleClass="modal-container"
      stylesheets="@../../css/style.css">

    <!-- Titulo do Formulario -->
    <Label fx:id="lblTituloForm" text="Nova Taxa Condominial" styleClass="modal-title"/>

    <!-- Formulario em Grade -->
    <GridPane hgap="16" vgap="14">
        <columnConstraints>
            <ColumnConstraints percentWidth="50"/>
            <ColumnConstraints percentWidth="50"/>
        </columnConstraints>

        <!-- LINHA 0: Unidade (largura total) -->
        <VBox spacing="5" GridPane.columnSpan="2" GridPane.rowIndex="0">
            <Label text="Unidade Associada *" styleClass="field-label"/>
            <ComboBox fx:id="cbUnidade"
                      promptText="Selecione a Unidade..."
                      maxWidth="Infinity"
                      styleClass="combo-box"/>
        </VBox>

        <!-- LINHA 1: Valor + Vencimento -->
        <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="1">
            <Label text="Valor (R$) *" styleClass="field-label"/>
            <TextField fx:id="txtValor"
                       promptText="0,00"
                       maxWidth="Infinity"
                       styleClass="text-field"/>
        </VBox>

        <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1">
            <Label text="Vencimento *" styleClass="field-label"/>
            <DatePicker fx:id="dpVencimento"
                        promptText="dd/mm/aaaa"
                        maxWidth="Infinity"
                        styleClass="date-picker"/>
        </VBox>

        <!-- LINHA 2: Situacao (largura total) -->
        <VBox spacing="5" GridPane.columnSpan="2" GridPane.rowIndex="2">
            <Label text="Situação *" styleClass="field-label"/>
            <ComboBox fx:id="cbSituacao"
                      maxWidth="Infinity"
                      styleClass="combo-box"/>
        </VBox>

    </GridPane>

    <!-- Botoes de Acao -->
    <HBox alignment="CENTER_RIGHT" spacing="12"
          style="-fx-padding: 14 0 0 0; -fx-border-color: #e2e8f0; -fx-border-width: 1 0 0 0;">

        <Button text="Cancelar"
                onAction="#onCancelar"
                styleClass="btn-secondary"/>

        <Button text="Salvar Taxa"
                onAction="#onSalvar"
                defaultButton="true"
                styleClass="btn-primary"/>
    </HBox>

</VBox>
