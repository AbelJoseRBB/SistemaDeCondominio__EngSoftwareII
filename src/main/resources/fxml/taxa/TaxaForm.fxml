<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      xmlns="http://javafx.com/javafx/21"
      fx:controller="com.condomanager.controller.taxa.TaxaFormController"
      spacing="16"
      style="-fx-background-color: white; -fx-padding: 24;"
      stylesheets="@../../css/style.css">

    <Label fx:id="lblTituloForm" text="Nova Taxa Condominial" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>

    <GridPane hgap="16" vgap="16">
        <columnConstraints>
            <ColumnConstraints hgrow="NEVER" minWidth="120" />
            <ColumnConstraints hgrow="ALWAYS" />
        </columnConstraints>

        <Label text="Unidade Associada:" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <ComboBox fx:id="cbUnidade" prefWidth="300" styleClass="text-field" GridPane.columnIndex="1" GridPane.rowIndex="0" promptText="Selecione a Unidade" />

        <Label text="Valor (R$):" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <TextField fx:id="txtValor" prefWidth="300" styleClass="text-field" GridPane.columnIndex="1" GridPane.rowIndex="1" promptText="0,00" />

        <Label text="Vencimento:" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <DatePicker fx:id="dpVencimento" prefWidth="300" styleClass="text-field" GridPane.columnIndex="1" GridPane.rowIndex="2" promptText="DD/MM/AAAA" />

        <Label text="Situação:" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <ComboBox fx:id="cbSituacao" prefWidth="300" styleClass="text-field" GridPane.columnIndex="1" GridPane.rowIndex="3" />
    </GridPane>

    <HBox alignment="CENTER_RIGHT" spacing="12" style="-fx-padding: 16 0 0 0;">
        <Button text="Cancelar" onAction="#onCancelar"
                style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569; -fx-padding: 8 16 8 16; -fx-background-radius: 6; -fx-cursor: hand; -fx-font-weight: bold;"/>
        <Button text="Salvar Taxa" onAction="#onSalvar"
                styleClass="login-button" style="-fx-padding: 8 16 8 16;"/>
    </HBox>
</VBox>
