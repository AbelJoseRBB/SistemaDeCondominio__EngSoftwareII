<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<!--
    FORMULARIO DE CADASTRO / EDICAO DE MANUTENCAO
    Controller: com.condomanager.controller.manutencao.ManutencaoFormController
-->
<VBox xmlns:fx="http://javafx.com/fxml/1"
      xmlns="http://javafx.com/javafx/21"
      fx:controller="com.condomanager.controller.manutencao.ManutencaoFormController"
      spacing="16"
      prefWidth="540"
      styleClass="modal-container"
      stylesheets="@../../css/style.css">

    <!-- Titulo do Formulario -->
    <Label fx:id="lblTitulo" text="Nova Manutenção" styleClass="modal-title"/>

    <!-- Formulario em Grade -->
    <GridPane hgap="16" vgap="14">
        <columnConstraints>
            <ColumnConstraints percentWidth="50"/>
            <ColumnConstraints percentWidth="50"/>
        </columnConstraints>

        <!-- LINHA 0: Descricao (largura total) -->
        <VBox spacing="5" GridPane.columnSpan="2" GridPane.rowIndex="0">
            <Label text="Descrição *" styleClass="field-label"/>
            <TextField fx:id="txtDescricao"
                       promptText="Ex: Troca de bomba d'água"
                       maxWidth="Infinity"
                       styleClass="text-field"/>
        </VBox>

        <!-- LINHA 1: Local + Responsavel -->
        <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="1">
            <Label text="Local" styleClass="field-label"/>
            <TextField fx:id="txtLocal"
                       promptText="Ex: Casa de máquinas"
                       maxWidth="Infinity"
                       styleClass="text-field"/>
        </VBox>

        <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1">
            <Label text="Responsável" styleClass="field-label"/>
            <TextField fx:id="txtResponsavel"
                       promptText="Ex: Hidráulica Rápida"
                       maxWidth="Infinity"
                       styleClass="text-field"/>
        </VBox>

        <!-- LINHA 2: Data Prevista + Situacao -->
        <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="2">
            <Label text="Data Prevista *" styleClass="field-label"/>
            <DatePicker fx:id="dpDataSolicitacao"
                        maxWidth="Infinity"
                        promptText="dd/mm/aaaa"
                        styleClass="date-picker"/>
        </VBox>

        <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="2">
            <Label text="Situação *" styleClass="field-label"/>
            <ComboBox fx:id="cbSituacao"
                      maxWidth="Infinity"
                      styleClass="combo-box"/>
        </VBox>

        <!-- LINHA 3: Custo -->
        <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="3">
            <Label text="Custo Estimado (R$)" styleClass="field-label"/>
            <TextField fx:id="txtCusto"
                       promptText="0,00"
                       maxWidth="Infinity"
                       styleClass="text-field"/>
        </VBox>

        <!-- LINHA 4: Observacoes (largura total) -->
        <VBox spacing="5" GridPane.columnSpan="2" GridPane.rowIndex="4">
            <Label text="Observações (opcional)" styleClass="field-label"/>
            <TextArea fx:id="txtObservacoes"
                      promptText="Detalhes adicionais sobre a manutenção..."
                      prefRowCount="3"
                      wrapText="true"
                      maxWidth="Infinity"
                      styleClass="text-field"/>
        </VBox>

    </GridPane>

    <!-- Botoes de Acao -->
    <HBox alignment="CENTER_RIGHT" spacing="12"
          style="-fx-padding: 14 0 0 0; -fx-border-color: #e2e8f0; -fx-border-width: 1 0 0 0;">

        <Button text="Cancelar"
                onAction="#cancelar"
                styleClass="btn-secondary"/>

        <Button text="Salvar"
                onAction="#salvar"
                defaultButton="true"
                styleClass="btn-primary"/>
    </HBox>

</VBox>
