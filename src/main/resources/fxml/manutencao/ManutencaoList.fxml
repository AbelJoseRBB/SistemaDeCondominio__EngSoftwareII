<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      xmlns="http://javafx.com/javafx/21"
      fx:controller="com.condomanager.controller.manutencao.ManutencaoListController"
      spacing="16"
      style="-fx-background-color: #f5f7fa; -fx-padding: 24 28 24 28;"
      stylesheets="@../../css/style.css">

    <HBox alignment="CENTER_LEFT" spacing="16">
        <VBox spacing="2" HBox.hgrow="ALWAYS">
            <Label text="Manutenções" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1a2332;"/>
            <Label text="Solicitações e controle de manutenção" style="-fx-font-size: 13px; -fx-text-fill: #7a8b9a;"/>
        </VBox>

        <TextField fx:id="txtBusca" promptText="🔍 Buscar por descrição, local ou responsável" 
                   prefWidth="350" style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 4; -fx-padding: 8;"/>
        
        <ComboBox fx:id="cbFiltroStatus" prefWidth="150" 
                  style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 4;"/>
        
        <Button text="+ Nova Manutenção" onAction="#abrirFormularioNovo"
                style="-fx-background-color: #1e3a5f; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 4; -fx-cursor: hand;"/>
    </HBox>

    <TableView fx:id="tableView" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 4;">
        <columns>
            <TableColumn fx:id="colDescricao" text="SOLICITAÇÃO" prefWidth="250"/>
            <TableColumn fx:id="colLocal" text="LOCAL" prefWidth="150"/>
            <TableColumn fx:id="colResponsavel" text="RESPONSÁVEL" prefWidth="150"/>
            <TableColumn fx:id="colDataSolicitacao" text="DATA SOLIC." prefWidth="120" style="-fx-alignment: CENTER;"/>
            <TableColumn fx:id="colCusto" text="CUSTO" prefWidth="120" style="-fx-alignment: CENTER;"/>
            <TableColumn fx:id="colSituacao" text="SITUAÇÃO" prefWidth="120" style="-fx-alignment: CENTER;"/>
            <TableColumn fx:id="colAcoes" text="AÇÕES" prefWidth="100" style="-fx-alignment: CENTER;"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <HBox alignment="CENTER_LEFT">
        <Label fx:id="lblTotalRegistros" text="0 registro(s)" style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;"/>
    </HBox>
</VBox>