<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<?import javafx.scene.shape.*?>

<!--
    TELA PRINCIPAL - Container com sidebar fixa
    Carrega os modulos na area de conteudo dinamicamente.
    Controller: com.condomanager.controller.MainLayoutController
-->
<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.condomanager.controller.MainLayoutController"
            prefWidth="1024" prefHeight="680">

    <!-- SIDEBAR ESQUERDA (fixa) -->
    <left>
        <VBox fx:id="sidebar" styleClass="sidebar">
            
            <!-- Logo / Nome do sistema -->
            <HBox styleClass="sidebar-header, sidebar-logo-container">
                <StackPane styleClass="sidebar-logo-icon">
                    <SVGPath content="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z" styleClass="sidebar-logo-svg"/>
                </StackPane>
                <VBox styleClass="sidebar-title-container">
                    <Label text="CondoManager" styleClass="sidebar-title"/>
                    <Label text="v1.0" styleClass="sidebar-subtitle"/>
                </VBox>
            </HBox>

            <!-- Itens do menu -->
            <VBox styleClass="sidebar-nav" VBox.vgrow="ALWAYS">
                <Button fx:id="btnDashboard" text="Dashboard" onAction="#onDashboard" styleClass="sidebar-btn" maxWidth="Infinity">
                    <graphic>
                        <SVGPath content="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z" styleClass="svg-icon"/>
                    </graphic>
                </Button>
                <Button fx:id="btnUnidades" text="Unidades" onAction="#onUnidades" styleClass="sidebar-btn" maxWidth="Infinity">
                    <graphic>
                        <SVGPath content="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" styleClass="svg-icon"/>
                    </graphic>
                </Button>
                <Button fx:id="btnMoradores" text="Moradores" onAction="#onMoradores" styleClass="sidebar-btn" maxWidth="Infinity">
                    <graphic>
                        <SVGPath content="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z" styleClass="svg-icon"/>
                    </graphic>
                </Button>
                <Button fx:id="btnTaxas" text="Taxas" onAction="#onTaxas" styleClass="sidebar-btn" maxWidth="Infinity">
                    <graphic>
                        <SVGPath content="M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z" styleClass="svg-icon"/>
                    </graphic>
                </Button>
                <Button fx:id="btnReservas" text="Reservas" onAction="#onReservas" styleClass="sidebar-btn" maxWidth="Infinity">
                    <graphic>
                        <SVGPath content="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM7 10h5v5H7z" styleClass="svg-icon"/>
                    </graphic>
                </Button>
                <Button fx:id="btnOcorrencias" text="Ocorrências" onAction="#onOcorrencias" styleClass="sidebar-btn" maxWidth="Infinity">
                    <graphic>
                        <SVGPath content="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z" styleClass="svg-icon"/>
                    </graphic>
                </Button>
                <Button fx:id="btnManutencoes" text="Manutenções" onAction="#onManutencoes" styleClass="sidebar-btn" maxWidth="Infinity">
                    <graphic>
                        <SVGPath content="M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z" styleClass="svg-icon"/>
                    </graphic>
                </Button>
                <Button fx:id="btnVeiculos" text="Veículos" onAction="#onVeiculos" styleClass="sidebar-btn" maxWidth="Infinity">
                    <graphic>
                        <SVGPath content="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.21.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8l-2.08-5.99zM6.5 16c-.83 0-1.5-.67-1.5-1.5S5.67 13 6.5 13s1.5.67 1.5 1.5S7.33 16 6.5 16zm11 0c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zM5 11l1.5-4.5h11L19 11H5z" styleClass="svg-icon"/>
                    </graphic>
                </Button>
                <Button fx:id="btnRelatorios" text="Relatórios" onAction="#onRelatorios" styleClass="sidebar-btn" maxWidth="Infinity">
                    <graphic>
                        <SVGPath content="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z" styleClass="svg-icon"/>
                    </graphic>
                </Button>
            </VBox>

            <!-- Info do usuario logado + Sair -->
            <VBox styleClass="sidebar-footer">
                <HBox styleClass="sidebar-user-container">
                    <Label fx:id="lblIniciais" text="U" styleClass="sidebar-avatar"/>
                    <VBox>
                        <Label fx:id="lblUsuario" text="Usuario" styleClass="sidebar-username"/>
                        <Label fx:id="lblPerfil" text="Perfil" styleClass="sidebar-userrole"/>
                    </VBox>
                </HBox>
                <Button fx:id="btnSair" text="Sair" onAction="#onSair" styleClass="sidebar-logout-btn" maxWidth="Infinity">
                    <graphic>
                        <SVGPath content="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z" styleClass="svg-icon"/>
                    </graphic>
                </Button>
            </VBox>
        </VBox>
    </left>

    <!-- AREA DE CONTEUDO (troca dinamicamente) -->
    <center>
        <StackPane fx:id="contentArea">
            <!-- Cada modulo sera carregado aqui via FXMLLoader -->
        </StackPane>
    </center>

</BorderPane>
