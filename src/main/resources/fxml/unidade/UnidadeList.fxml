<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<!--
    TELA DE LISTAGEM DE UNIDADES
    Exibe tabela com todas as unidades cadastradas, busca em tempo real
    e botao para abrir o formulario modal de cadastro/edicao.
    Controller: com.condomanager.controller.unidade.UnidadeListController
-->
<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.condomanager.controller.unidade.UnidadeListController"
      spacing="20"
      styleClass="container"
      stylesheets="@../../css/style.css">

    <!-- ================================================================ -->
    <!-- CABECALHO DA PAGINA                                               -->
    <!-- ================================================================ -->
    <HBox alignment="CENTER_LEFT" spacing="12">

        <!-- Titulo e subtitulo -->
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Unidades" styleClass="heading"/>
            <Label text="Gerenciamento de unidades e proprietários do condomínio" styleClass="subheading"/>
        </VBox>

        <!-- Campo de busca -->
        <TextField fx:id="txtBusca"
                   promptText="🔍 Buscar por bloco, número ou proprietário..."
                   prefWidth="300"
                   styleClass="search-field"/>

        <!-- Botao Nova Unidade -->
        <Button fx:id="btnNovaUnidade"
                text="+ Nova Unidade"
                onAction="#onNovaUnidade"
                styleClass="btn-primary"/>
    </HBox>

    <!-- ================================================================ -->
    <!-- TABELA DE UNIDADES                                                -->
    <!-- ================================================================ -->
    <VBox VBox.vgrow="ALWAYS" styleClass="dashboard-table-card">

        <TableView fx:id="tabelaUnidades"
                   VBox.vgrow="ALWAYS"
                   styleClass="table-view-ocorrencias">
            <placeholder>
                <Label text="Nenhuma unidade cadastrada."
                       style="-fx-text-fill: #9ca3af; -fx-font-size: 14px;"/>
            </placeholder>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <columns>

                <TableColumn fx:id="colBloco"
                             text="BLOCO"
                             prefWidth="80"
                             style="-fx-alignment: CENTER;"/>

                <TableColumn fx:id="colNumero"
                             text="UNIDADE"
                             prefWidth="90"
                             style="-fx-alignment: CENTER;"/>

                <TableColumn fx:id="colProprietario"
                             text="PROPRIETÁRIO"
                             prefWidth="190"/>

                <!-- Coluna de situacao - celula customizada criada no controller -->
                <TableColumn fx:id="colSituacao"
                             text="OCUPAÇÃO"
                             prefWidth="120"
                             style="-fx-alignment: CENTER;"/>

                <TableColumn fx:id="colTelefone"
                             text="TELEFONE"
                             prefWidth="140"/>

                <TableColumn fx:id="colEmail"
                             text="E-MAIL"
                             prefWidth="190"/>

                <!-- Coluna de acoes - celula customizada criada no controller -->
                <TableColumn fx:id="colAcoes"
                             text="AÇÕES"
                             prefWidth="100"
                             sortable="false"
                             style="-fx-alignment: CENTER;"/>

            </columns>
        </TableView>

        <!-- ================================================================ -->
        <!-- RODAPE COM CONTAGEM DE REGISTROS                                  -->
        <!-- ================================================================ -->
        <HBox alignment="CENTER_LEFT" style="-fx-padding: 10 0 0 0;">
            <Label fx:id="lblContagem"
                   text="0 registro(s) encontrado(s)"
                   styleClass="subheading"/>
        </HBox>

    </VBox>

</VBox>
