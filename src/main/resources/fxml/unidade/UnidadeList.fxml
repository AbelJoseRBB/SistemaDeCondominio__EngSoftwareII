<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<!--
    TELA DE LISTAGEM DE UNIDADES
    Exibe tabela com todas as unidades cadastradas, busca em tempo real
    e botao para abrir o formulario modal de cadastro/edicao.
    Controller: com.condomanager.controller.unidade.UnidadeListController
-->
<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.condomanager.controller.unidade.UnidadeListController"
      spacing="0"
      style="-fx-background-color: #f5f7fa;">

    <!-- ================================================================ -->
    <!-- CABECALHO DA PAGINA                                               -->
    <!-- ================================================================ -->
    <HBox alignment="CENTER_LEFT"
          style="-fx-padding: 24 28 16 28; -fx-background-color: #f5f7fa;">

        <!-- Titulo e subtitulo -->
        <VBox spacing="2" HBox.hgrow="ALWAYS">
            <Label text="Unidades"
                   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1a2332;"/>
            <Label text="Gerenciamento de unidades do condominio"
                   style="-fx-font-size: 13px; -fx-text-fill: #7a8b9a;"/>
        </VBox>

        <!-- Campo de busca -->
        <TextField fx:id="txtBusca"
                   promptText="Buscar por bloco, numero ou proprietario..."
                   prefWidth="300"
                   style="-fx-background-color: white;
                          -fx-border-color: #d1d5db;
                          -fx-border-radius: 5;
                          -fx-background-radius: 5;
                          -fx-padding: 8 12 8 12;
                          -fx-font-size: 13px;
                          -fx-text-fill: #334155;
                          -fx-prompt-text-fill: #9ca3af;">
            <HBox.margin>
                <Insets right="12"/>
            </HBox.margin>
        </TextField>

        <!-- Botao Nova Unidade -->
        <Button fx:id="btnNovaUnidade"
                text="+ Nova Unidade"
                onAction="#onNovaUnidade"
                style="-fx-background-color: #203a5c;
                       -fx-text-fill: white;
                       -fx-font-size: 13px;
                       -fx-font-weight: bold;
                       -fx-background-radius: 5;
                       -fx-padding: 9 18 9 18;
                       -fx-cursor: hand;"/>
    </HBox>

    <!-- ================================================================ -->
    <!-- TABELA DE UNIDADES                                                -->
    <!-- ================================================================ -->
    <VBox VBox.vgrow="ALWAYS"
          style="-fx-padding: 0 28 0 28;">

        <TableView fx:id="tabelaUnidades"
                   VBox.vgrow="ALWAYS"
                   style="-fx-background-color: white;
                          -fx-border-color: #e5e7eb;
                          -fx-border-radius: 8;
                          -fx-background-radius: 8;"
                   placeholder="">
            <placeholder>
                <Label text="Nenhuma unidade cadastrada."
                       style="-fx-text-fill: #9ca3af; -fx-font-size: 14px;"/>
            </placeholder>
            <columns>

                <TableColumn fx:id="colBloco"
                             text="BLOCO"
                             prefWidth="80"
                             style="-fx-alignment: CENTER;"/>

                <TableColumn fx:id="colNumero"
                             text="UNIDADE"
                             prefWidth="90"
                             style="-fx-alignment: CENTER;"/>

                <TableColumn fx:id="colProprietario"
                             text="PROPRIETÁRIO"
                             prefWidth="180"/>

                <!-- Coluna de situacao - celula customizada criada no controller -->
                <TableColumn fx:id="colSituacao"
                             text="OCUPAÇÃO"
                             prefWidth="120"
                             style="-fx-alignment: CENTER;"/>

                <TableColumn fx:id="colTelefone"
                             text="TELEFONE"
                             prefWidth="140"/>

                <TableColumn fx:id="colEmail"
                             text="E-MAIL"
                             prefWidth="200"/>

                <!-- Coluna de acoes - celula customizada criada no controller -->
                <TableColumn fx:id="colAcoes"
                             text="AÇÕES"
                             prefWidth="110"
                             sortable="false"
                             style="-fx-alignment: CENTER;"/>

            </columns>
        </TableView>
    </VBox>

    <!-- ================================================================ -->
    <!-- RODAPE COM CONTAGEM DE REGISTROS                                  -->
    <!-- ================================================================ -->
    <HBox style="-fx-padding: 10 28 16 28;">
        <Label fx:id="lblContagem"
               text="0 registro(s) encontrado(s)"
               style="-fx-font-size: 12px; -fx-text-fill: #7a8b9a;"/>
    </HBox>

</VBox>
