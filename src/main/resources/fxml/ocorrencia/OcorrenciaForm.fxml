<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<!--
    FORMULARIO DE CADASTRO / EDICAO DE OCORRENCIA
    Carregado como conteudo de um Dialog pelo OcorrenciaListController.
    Controller: com.condomanager.controller.ocorrencia.OcorrenciaFormController
-->
<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.condomanager.controller.ocorrencia.OcorrenciaFormController"
      spacing="16"
      prefWidth="520"
      styleClass="modal-container"
      stylesheets="@../../css/style.css">

    <!-- Titulo do Formulario -->
    <Label text="Dados da Ocorrência" styleClass="modal-title"/>

    <!-- LINHA 1: Categoria + Situacao -->
    <HBox spacing="16">
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="Tipo / Categoria *" styleClass="field-label"/>
            <ComboBox fx:id="cmbCategoria"
                      maxWidth="Infinity"
                      styleClass="combo-box"/>
        </VBox>

        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="Situação" styleClass="field-label"/>
            <ComboBox fx:id="cmbSituacao"
                      maxWidth="Infinity"
                      styleClass="combo-box"/>
        </VBox>
    </HBox>

    <!-- LINHA 2: Titulo (largura total) -->
    <VBox spacing="5">
        <Label text="Título da Ocorrência *" styleClass="field-label"/>
        <TextField fx:id="txtTitulo"
                   promptText="Descreva brevemente a ocorrência"
                   maxWidth="Infinity"
                   styleClass="text-field"/>
    </VBox>

    <!-- LINHA 3: Local / Unidade (largura total) -->
    <VBox spacing="5">
        <Label text="Local / Unidade" styleClass="field-label"/>
        <TextField fx:id="txtLocal"
                   promptText="Ex: Garagem B2, Bloco A - 3° andar, Área externa..."
                   maxWidth="Infinity"
                   styleClass="text-field"/>
        <Label text="Deixe em branco para ocorrências sem local específico."
               style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;"/>
    </VBox>

    <!-- LINHA 4: Descricao (TextArea obrigatoria) -->
    <VBox spacing="5">
        <Label text="Descrição *" styleClass="field-label"/>
        <TextArea fx:id="txtDescricao"
                  promptText="Descreva detalhadamente a ocorrência..."
                  prefRowCount="3"
                  wrapText="true"
                  maxWidth="Infinity"
                  styleClass="text-field"/>
    </VBox>

    <!-- LINHA 5: Observacoes (opcional) -->
    <VBox spacing="5">
        <Label text="Observações (opcional)" styleClass="field-label"/>
        <TextArea fx:id="txtObservacoes"
                  promptText="Informações adicionais, resposta ou encaminhamento..."
                  prefRowCount="2"
                  wrapText="true"
                  maxWidth="Infinity"
                  styleClass="text-field"/>
    </VBox>

    <!-- Botoes de Acao -->
    <HBox alignment="CENTER_RIGHT" spacing="12"
          style="-fx-padding: 14 0 0 0; -fx-border-color: #e2e8f0; -fx-border-width: 1 0 0 0;">

        <Button fx:id="btnCancelar"
                text="Cancelar"
                onAction="#onCancelar"
                styleClass="btn-secondary"/>

        <Button fx:id="btnSalvar"
                text="Salvar"
                onAction="#onSalvar"
                defaultButton="true"
                styleClass="btn-primary"/>
    </HBox>

</VBox>
